# Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Optional: Guild ID for instant slash command testing (skips 1 hour global sync)
# DEV_GUILD_ID=123456789012345678

# Database Path (default: data/backloggd.db - used for local SQLite)
DATABASE_PATH=data/backloggd.db

# Backloggd Session Cookie (_backloggd_session)
# Extract from DevTools (F12 -> Application -> Cookies -> https://backloggd.com -> _backloggd_session)
BACKLOGGD_SESSION=your_backloggd_session_cookie_here

# Optional: Remote libSQL database (omit to use local SQLite at DATABASE_PATH)
# LIBSQL_DATABASE_URL=your_libsql_database_url
# LIBSQL_AUTH_TOKEN=your_database_auth_token

# Optional: Upstream Backloggd session/challenge/rate-limit alerts
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ALERT_OWNER_DM=true

# Optional: Set to "json" for single-line JSON stdout logs (default: plain text)
# LOG_FORMAT=json

# Optional: Concurrent Discord feed delivery workers per poll tick (default: 2, range: 1-5)
# FEED_DELIVERY_CONCURRENCY=2

# Optional: Feed operational tuning
# FEED_ADAPTIVE_POLL_THRESHOLD=40
# HISTORY_RETENTION_DAYS=90
# MISSING_GUILD_PAUSE_HOURS=24
