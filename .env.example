# Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Optional: Guild ID for instant slash command testing (skips 1 hour global sync)
# DEV_GUILD_ID=123456789012345678

# Database Path (default: data/backloggd.db - used for local SQLite)
DATABASE_PATH=data/backloggd.db

# Turso Cloud SQLite (Recommended for persistent cloud hosting like Render/Fly.io)
# Sign up at https://turso.tech, create a database, and paste credentials here:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Optional: Backloggd Session Cookie (_backloggd_session)
# Required if deploying on cloud servers where Cloudflare challenges unauthenticated requests.
# Extract from DevTools (F12 -> Application -> Cookies -> https://backloggd.com -> _backloggd_session)
# BACKLOGGD_SESSION=your_backloggd_session_cookie_here

